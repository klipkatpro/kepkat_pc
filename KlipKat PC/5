        <div className="absolute inset-0 grid grid-cols-3 grid-rows-3 pointer-events-none opacity-0 group-hover:opacity-100 group-active:opacity-100 transition-opacity"><div className="border-r border-b border-white/40"></div><div className="border-r border-b border-white/40"></div><div className="border-b border-white/40"></div><div className="border-r border-b border-white/40"></div><div className="border-r border-b border-white/40"></div><div className="border-b border-white/40"></div><div className="border-r border-white/40"></div><div className="border-r border-white/40"></div><div></div></div>

        <div onPointerDown={(e) => handlePointerDown(e, boxIndex, 'nw')} className="absolute -left-[4px] -top-[4px] w-3 h-3 cursor-nwse-resize z-30 bg-white border-2 border-zinc-900 shadow rounded-sm transition-transform hover:scale-125"></div>
