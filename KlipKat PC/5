        <div onPointerDown={(e) => handlePointerDown(e, boxIndex, 'e')} className="absolute top-4 bottom-4 right-0 w-4 -mr-2 cursor-ew-resize z-30 flex items-center justify-center group/e"><div className="h-8 w-1 bg-white/70 rounded-full opacity-0 group-hover/e:opacity-100 transition-opacity shadow"></div></div>
        <div onPointerDown={(e) => handlePointerDown(e, boxIndex, 'w')} className="absolute top-4 bottom-4 left-0 w-4 -ml-2 cursor-ew-resize z-30 flex items-center justify-center group/w"><div className="h-8 w-1 bg-white/70 rounded-full opacity-0 group-hover/w:opacity-100 transition-opacity shadow"></div></div>
    </div>
);

const CropModal = ({ selectedClips, videoUrl, onClose, onSaveAll }) => {
    const [modalClips, setModalClips] = useState([...selectedClips]);
    const [activeClipId, setActiveClipId] = useState(selectedClips[0]?.id);
    const [checkedClips, setCheckedClips] = useState([]);
    const [lockedClips, setLockedClips] = useState([]);

    const [videoAspect, setVideoAspect] = useState(16/9);
    const [isPlaying, setIsPlaying] = useState(false);
    const [currentTime, setCurrentTime] = useState(0);
    const [duration, setDuration] = useState(0);

    const [isScrubbing, setIsScrubbing] = useState(false);
    const [isFullscreenModalOpen, setIsFullscreenModalOpen] = useState(false);

    const [selectedKeyframes, setSelectedKeyframes] = useState([]);
    const [contextMenu, setContextMenu] = useState(null);

    const [isSmoothMode, setIsSmoothMode] = useState(false);
    const [timelineZoom, setTimelineZoom] = useState(1);

    const [history, setHistory] = useState(() => {
        const init = {};
        selectedClips.forEach(c => init[c.id] = { past: [], future: [] });
        return init;
    });

    // MEMUAT DATA DARI CACHE BROWSER AGAR EDITAN TIDAK HILANG SAAT KELUAR MASUK
    const [localCrops, setLocalCrops] = useState(() => {
        const init = {};
        selectedClips.forEach(c => {
            const cachedData = localStorage.getItem(`crop_edit_data_${c.id}`);
            if (cachedData) {
                try {
                    init[c.id] = JSON.parse(cachedData);
                } catch(e) {}
            }
            if (!init[c.id]) {
                init[c.id] = {
                    isApplied: false,
                    keyframes: [
                        { time: 0, frameCount: 1, layout: '1-full', boxes: [{ x: 34.18, y: 0, w: 31.64, h: 100, ratio: 9/16 }], transition: 'cut' }
                    ]
                };
            }
        });
        return init;
    });

    // MENYIMPAN DATA OTOMATIS KE CACHE SETIAP ADA PERUBAHAN
    useEffect(() => {
        Object.entries(localCrops).forEach(([id, data]) => {
            localStorage.setItem(`crop_edit_data_${id}`, JSON.stringify(data));
        });
    }, [localCrops]);

    const saveHistory = (idToSave = activeClipId) => {
        setHistory(h => ({
            ...h,
            [idToSave]: {
                past: [...(h[idToSave]?.past || []), localCrops[idToSave]],
                future: []
            }
        }));
    };

    const handleUndo = () => {
        if(lockedClips.includes(activeClipId)) return;
        setHistory(h => {
            const ch = h[activeClipId];
            if (!ch || ch.past.length === 0) return h;
            const prevState = ch.past[ch.past.length - 1];
            setLocalCrops(prev => ({ ...prev, [activeClipId]: prevState }));
            return { ...h, [activeClipId]: { past: ch.past.slice(0, -1), future: [localCrops[activeClipId], ...ch.future] } };
        });
    };

    const handleRedo = () => {
        if(lockedClips.includes(activeClipId)) return;
        setHistory(h => {
            const ch = h[activeClipId];
            if (!ch || ch.future.length === 0) return h;
            const nextState = ch.future[0];
            setLocalCrops(prev => ({ ...prev, [activeClipId]: nextState }));
            return { ...h, [activeClipId]: { past: [...ch.past, localCrops[activeClipId]], future: ch.future.slice(1) } };
        });
    };

    const activeClip = modalClips.find(c => c.id === activeClipId);
    const curClip = localCrops[activeClipId] || {};
    const activeKeyframes = curClip.keyframes || [];

    let activeData = activeKeyframes[0] || { frameCount: 1, layout: '1-full', boxes: [{ x: 34.18, y: 0, w: 31.64, h: 100, ratio: 9/16 }], transition: 'cut' };
    let kf1 = activeKeyframes[0];
    let kf2 = activeKeyframes[0];

    for (let i = 0; i < activeKeyframes.length; i++) {
        if (currentTime >= activeKeyframes[i].time - 0.02) {
            kf1 = activeKeyframes[i];
            kf2 = activeKeyframes[i + 1] || activeKeyframes[i];
        }
    }

    // PEMBARUAN: Transisi smooth tanpa ada batasan kf1.layout === kf2.layout agar perpindahan antar layout berjalan mulus.
    if (kf1 && kf2 && kf1 !== kf2 && kf1.transition === 'smooth' && kf1.frameCount === kf2.frameCount) {
        const timeDiff = kf2.time - kf1.time;
        if (timeDiff > 0) {
            let progress = (currentTime - kf1.time) / timeDiff;
            progress = Math.max(0, Math.min(1, progress));

            // Rumus Sine In-Out yang bikin super smooth (Page Velocity)
            let ease = -(Math.cos(Math.PI * progress) - 1) / 2;

            let interpBoxes = kf1.boxes.map((b1, idx) => {
                let b2 = kf2.boxes[idx];
                if(!b2) return b1;

                let interpW = b1.w + (b2.w - b1.w) * ease;
                let interpH = b1.h + (b2.h - b1.h) * ease;
                // Anti gambar penyet, rasio dihitung otomatis dari lebar/tinggi berjalan dikali video source
                let interpRatio = (interpW / interpH) * videoAspect;

                return {
                    ...b1,
                    x: b1.x + (b2.x - b1.x) * ease,
                    y: b1.y + (b2.y - b1.y) * ease,
                    w: interpW,
                    h: interpH,
                    ratio: interpRatio
                };
            });
            activeData = { ...kf1, boxes: interpBoxes };
        } else {
            activeData = kf1;
        }
    } else {
        activeData = kf1;
    }

    const videoRef = useRef(null);
    const containerRef = useRef(null);
    const timelineRef = useRef(null);
    const timelineContainerRef = useRef(null);

    const [activeBoxIndex, setActiveBoxIndex] = useState(null);
    const dragStart = useRef({
        isDragging: false, handle: null, boxIndex: null, x: 0, y: 0, startX: 0, startY: 0, boxX: 0, boxY: 0, boxW: 0, boxH: 0, containerW: 1, containerH: 1,
        isDraggingKeyframe: false, originalTime: null, scrubStartTime: null
    });

    useEffect(() => {
        const handleGlobalPointerDown = () => {
            if (contextMenu) setContextMenu(null);
        };
        window.addEventListener('pointerdown', handleGlobalPointerDown);
        return () => window.removeEventListener('pointerdown', handleGlobalPointerDown);
    }, [contextMenu]);

    useEffect(() => { if (modalClips.length === 0) onClose(); }, [modalClips]);

    useEffect(() => {
        if (videoRef.current && activeClip) {
            videoRef.current.currentTime = activeClip.start;
            setCurrentTime(activeClip.start);
            setIsPlaying(false);
            setSelectedKeyframes([]);
            setContextMenu(null);
        }
    }, [activeClipId]);

    useEffect(() => {
        let animationFrameId;
        const loop = () => {
            if (videoRef.current && isPlaying && !isScrubbing && !dragStart.current.isDraggingKeyframe) {
                const t = videoRef.current.currentTime;
                setCurrentTime(t);

                if (timelineContainerRef.current && activeClip) {
                    const container = timelineContainerRef.current;
                    const progress = (t - activeClip.start) / (activeClip.end - activeClip.start);
                    const totalWidth = container.scrollWidth;
                    const visibleWidth = container.clientWidth;
                    const playheadX = progress * totalWidth;

                    let targetScroll = playheadX - (visibleWidth / 2);
                    if (targetScroll < 0) targetScroll = 0;
                    if (targetScroll > totalWidth - visibleWidth) targetScroll = totalWidth - visibleWidth;

                    container.scrollLeft = targetScroll;
                }

                if (activeClip && t >= activeClip.end) {
                    videoRef.current.pause();
                    videoRef.current.currentTime = activeClip.start;
                    setIsPlaying(false);
                } else {
                    animationFrameId = requestAnimationFrame(loop);
                }
            }
        };
        if (isPlaying) animationFrameId = requestAnimationFrame(loop);
        return () => { if(animationFrameId) cancelAnimationFrame(animationFrameId); };
    }, [isPlaying, isScrubbing, activeClip]);

    const deleteSelectedKeyframes = () => {
        if (lockedClips.includes(activeClipId)) return;
        if (selectedKeyframes.length === 0) return;

        saveHistory();
        setLocalCrops(prev => {
            const cur = prev[activeClipId];
            let newKfs = cur.keyframes.filter(k => !selectedKeyframes.some(st => Math.abs(k.time - st) < 0.05));
            if (newKfs.length === 0) {
                newKfs = [{ ...cur.keyframes[0], time: 0 }];
            }
            return { ...prev, [activeClipId]: { ...cur, keyframes: newKfs } };
        });
        setSelectedKeyframes([]);
        setContextMenu(null);
    };

    const togglePlay = () => {
        if (!videoRef.current) return;

        if (videoRef.current.paused || !isPlaying) {
            if (activeClip && videoRef.current.currentTime >= activeClip.end) {
                videoRef.current.currentTime = activeClip.start;
            }
            const p = videoRef.current.play();
            if (p !== undefined) p.catch(()=>{});
            setIsPlaying(true);
        }
        else {
            videoRef.current.pause();
            setIsPlaying(false);
        }
    };

    useEffect(() => {
        const handleKeyDown = (e) => {
            if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;

            if (e.code === 'KeyZ' && (e.ctrlKey || e.metaKey)) { e.preventDefault(); handleUndo(); return; }
            if (e.code === 'KeyX' && (e.ctrlKey || e.metaKey)) { e.preventDefault(); handleRedo(); return; }

            if (e.code === 'Space') {
                e.preventDefault();
                togglePlay();
                return;
            }

            if (e.code === 'KeyQ' || e.code === 'ArrowLeft') { e.preventDefault(); stepFrame(false); }
            if (e.code === 'KeyW' || e.code === 'ArrowRight') { e.preventDefault(); stepFrame(true); }
            if (e.code === 'KeyA') { e.preventDefault(); stepTime(-1); }
            if (e.code === 'KeyS') { e.preventDefault(); stepTime(1); }

            if (e.code === 'KeyZ' && !e.ctrlKey && !e.metaKey) { e.preventDefault(); jumpToEdge(true); }
            if (e.code === 'KeyX' && !e.ctrlKey && !e.metaKey) { e.preventDefault(); jumpToEdge(false); }
            if (e.code === 'KeyE' && !e.ctrlKey && !e.metaKey) { e.preventDefault(); toggleKeyframe(); }

            if (e.code === 'Backspace' || e.code === 'Delete') {
                if (selectedKeyframes.length > 0) {
                    e.preventDefault();
                    deleteSelectedKeyframes();
                }
            }
        };
        window.addEventListener('keydown', handleKeyDown);
        return () => window.removeEventListener('keydown', handleKeyDown);
    }, [activeClipId, isPlaying, modalClips, activeClip, history, localCrops, currentTime, selectedKeyframes, isSmoothMode]);

    const handleTimeUpdate = () => {
        if (!videoRef.current || isScrubbing || dragStart.current.isDraggingKeyframe) return;
        const t = videoRef.current.currentTime;
        setCurrentTime(t);
        if (activeClip && t >= activeClip.end && isPlaying) {
            videoRef.current.pause();
            videoRef.current.currentTime = activeClip.start;
            setIsPlaying(false);
        }
    };

    const handleLoadedMetadata = (e) => {
        setDuration(e.target.duration);
        setVideoAspect(e.target.videoWidth / e.target.videoHeight);
    };

    const toggleCheck = (id, e) => { e.stopPropagation(); setCheckedClips(prev => prev.includes(id) ? prev.filter(x => x !== id) : [...prev, id]); };
    const toggleCheckAll = () => { setCheckedClips(prev => prev.length === modalClips.length ? [] : modalClips.map(c => c.id)); };

    const toggleLockChecked = () => {
        if (checkedClips.length === 0) return;
        setLockedClips(prev => {
            let newlyLocked = [...prev];
            const allLocked = checkedClips.every(id => prev.includes(id));
            if (allLocked) {
                newlyLocked = newlyLocked.filter(id => !checkedClips.includes(id));
            } else {
                checkedClips.forEach(id => { if (!newlyLocked.includes(id)) newlyLocked.push(id); });
            }
            return newlyLocked;
        });
    };

    const deleteCheckedClips = () => {
        const remaining = modalClips.filter(c => !(checkedClips.includes(c.id) && !lockedClips.includes(c.id)));
        setModalClips(remaining);
        setCheckedClips(checkedClips.filter(id => lockedClips.includes(id)));
        if (checkedClips.includes(activeClipId) && !lockedClips.includes(activeClipId) && remaining.length > 0) setActiveClipId(remaining[0].id);
    };

    const stepFrame = (forward) => {
        const step = forward ? 0.01 : -0.01;
        if (videoRef.current && activeClip) {
            videoRef.current.pause();
            setIsPlaying(false);

            if (selectedKeyframes.length > 0 && !lockedClips.includes(activeClipId)) {
                saveHistory();
                let updatedTimes = [];

                setLocalCrops(prev => {
                    const cur = prev[activeClipId];
                    let newKfs = [...cur.keyframes];

                    selectedKeyframes.forEach(targetTime => {
                        const targetIdx = newKfs.findIndex(k => Math.abs(k.time - targetTime) < 0.05);
                        if (targetIdx >= 0) {
                            let newTime = newKfs[targetIdx].time + step;
                            if (newTime < activeClip.start) newTime = activeClip.start;
                            if (newTime > activeClip.end) newTime = activeClip.end;
                            newTime = parseFloat(newTime.toFixed(3));

                            newKfs[targetIdx] = { ...newKfs[targetIdx], time: newTime };
                            updatedTimes.push(newTime);
                        }
                    });

                    newKfs.sort((a,b) => a.time - b.time);
                    return { ...prev, [activeClipId]: { ...cur, keyframes: newKfs } };
                });

                setTimeout(() => {
                    if (updatedTimes.length > 0) {
                        setSelectedKeyframes(updatedTimes);
                        if (videoRef.current) {
                            videoRef.current.currentTime = updatedTimes[0];
                        }
                        setCurrentTime(updatedTimes[0]);
                    }
                }, 0);
            } else {
                let newTime = videoRef.current.currentTime + step;
                if (newTime < activeClip.start) newTime = activeClip.start;
                if (newTime > activeClip.end) newTime = activeClip.end;

                videoRef.current.currentTime = newTime;
                setCurrentTime(newTime);
            }
        }
    };

    const stepTime = (sec) => { if (videoRef.current) { videoRef.current.pause(); setIsPlaying(false); videoRef.current.currentTime += sec; setCurrentTime(videoRef.current.currentTime); } };
    const jumpToEdge = (isStart) => { if (videoRef.current && activeClip) { videoRef.current.currentTime = isStart ? activeClip.start : activeClip.end; setCurrentTime(videoRef.current.currentTime); } };

    const toggleTransition = () => {
        const newMode = !isSmoothMode;
        setIsSmoothMode(newMode);
        saveHistory();

        let snapTime = null;

        setLocalCrops(prev => {
            const currentClip = prev[activeClipId];
            const tRound = parseFloat(currentTime.toFixed(2));
            let newKfs = [...currentClip.keyframes];
            let kfIdx = newKfs.findIndex(k => Math.abs(k.time - tRound) < 0.1);

            if (kfIdx >= 0) {
                newKfs[kfIdx] = { ...newKfs[kfIdx], transition: newMode ? 'smooth' : 'cut' };
                snapTime = newKfs[kfIdx].time;
            }

            return { ...prev, [activeClipId]: { ...currentClip, keyframes: newKfs } };
        });

        setTimeout(() => {
            if (snapTime !== null && videoRef.current) {
                videoRef.current.currentTime = snapTime;
                setCurrentTime(snapTime);
            }
        }, 0);
    };

    const getSlotRatio = (layout, frameCount, idx = 0) => {
        const rp = 9 / 16;
        let cols = 1; let rows = [1]; let rowIndex = 0; let colSpan = 1;

        if (layout === '4-grid-2x2' || layout === 'grid-2x2') { cols = 2; rows = [1, 1]; rowIndex = Math.floor(idx/2); }
        else if (layout === '6-grid-2x3' || layout === 'grid-2x3') { cols = 2; rows = [1, 1, 1]; rowIndex = Math.floor(idx/2); }
        else if (layout === '6-grid-3x2' || layout === 'grid-3x2') { cols = 3; rows = [1, 1]; rowIndex = Math.floor(idx/3); }
