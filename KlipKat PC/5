        <div onPointerDown={(e) => handlePointerDown(e, boxIndex, 'sw')} className="absolute -left-[4px] -bottom-[4px] w-3 h-3 cursor-nesw-resize z-30 bg-white border-2 border-zinc-900 shadow rounded-sm transition-transform hover:scale-125"></div>
        <div onPointerDown={(e) => handlePointerDown(e, boxIndex, 'se')} className="absolute -right-[4px] -bottom-[4px] w-3 h-3 cursor-nwse-resize z-30 bg-white border-2 border-zinc-900 shadow rounded-sm transition-transform hover:scale-125"></div>

        <div onPointerDown={(e) => handlePointerDown(e, boxIndex, 'n')} className="absolute top-0 left-4 right-4 h-4 -mt-2 cursor-ns-resize z-30 flex items-center justify-center group/n"><div className="w-8 h-1 bg-white/70 rounded-full opacity-0 group-hover/n:opacity-100 transition-opacity shadow"></div></div>
