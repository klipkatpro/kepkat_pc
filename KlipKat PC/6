        const formatDurationDisplay = (totalSeconds) => {
            if (isNaN(totalSeconds) || !isFinite(totalSeconds) || totalSeconds < 0) return "0 dtk";
            const s = Math.floor(totalSeconds);
            if (s < 60) return `${s} dtk`;
            const m = Math.floor(s / 60);
            const remS = s % 60;
            return remS > 0 ? `${m} mnt ${remS} dtk` : `${m} mnt`;
        };

        const formatTimeCompact = (totalSeconds) => {
            if (isNaN(totalSeconds) || !isFinite(totalSeconds) || totalSeconds < 0) return "00:00";
            const s = Math.floor(totalSeconds);
            const m = Math.floor(s / 60);
            const remS = s % 60;
            const h = Math.floor(m / 60);
            const remM = m % 60;
            if (h > 0) return `${h}:${remM.toString().padStart(2, '0')}:${remS.toString().padStart(2, '0')}`;
            return `${remM.toString().padStart(2, '0')}:${remS.toString().padStart(2, '0')}`;
