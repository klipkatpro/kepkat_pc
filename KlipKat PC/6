                    videoRef.current.play();
                    setIsPlaying(true);
                    setPreviewingClipId(clip.id);
                }
                }
            };

            const processAndCutClips = async (clipsToProcess) => {
                if (clipsToProcess.length === 0 || !videoIdHash) return;

                if (downloadStatus === 'downloading') {
                    addToast("Sabar cuy! Tunggu Download selesai dulu.", "warning");
                    return;
                }
                if (downloadStatus === 'blocked') {
                    addToast("Gagal! Server diblokir YouTube. Coba Restart Colab.", "error");
                    return;
                }
                if (downloadStatus === 'error') {
                    addToast("Video aslinya gagal di-download server.", "error");
                    return;
                }

                setIsProcessing(true);
                cancelRenderRef.current = false;
                setTotalProcessCount(clipsToProcess.length);
                setShowMyClipModal(true);

                for (let i = 0; i < clipsToProcess.length; i++) {
                    if (cancelRenderRef.current) break;

                    const c = clipsToProcess[i];
                    setCurrentProcessIndex(i + 1);
                    setCurrentClipName(c.name);
                    setProcessStatus(`Memotong klip ${i + 1} dari ${clipsToProcess.length}...`);
                    setProcessProgress(0);

                    // ====== JEMBATAN PENGIRIMAN DATA EDITAN UI KE SERVER ======
                    let advancedCropData = null;
                    try {
                        const cachedStr = localStorage.getItem(`crop_edit_data_${c.id}`);
                        if (cachedStr) {
                            advancedCropData = JSON.parse(cachedStr);
                        }
                    } catch(e) {}
                    // ==========================================================

                    const progressInterval = setInterval(async () => {
                        try {
                            const progRes = await fetch(`/api/cut_progress/${c.id}`);
                            const progData = await progRes.json();
                            if(progData.progress !== undefined) {
                                setProcessProgress(progData.progress);
                            }
                        } catch(e) {}
                    }, 500);

                    try {
                        const res = await fetch('/api/cut_single', {
                            method: "POST",
                            headers: { "Content-Type": "application/json" },
                            body: JSON.stringify({
                                video_id: videoIdHash,
                                start: c.start,
                                end: c.end,
                                name: c.name,
                                quality: globalQuality,
                                ratio: globalRatio,
                                clip_id: c.id.toString(),
                                gpu_mode: isGpuMode,
                                engine_speed: engineSpeed,
                                crop_data: advancedCropData // <--- Data editan masuk ke sini
                            })
                        });
                        clearInterval(progressInterval);
                        if (!res.ok) throw new Error("Gagal potong");

                        setProcessProgress(100);
                        await loadSavedClips();
                        await new Promise(r => setTimeout(r, 400));
                    } catch (err) {
                        clearInterval(progressInterval);
                        if (cancelRenderRef.current) {
                            console.log("Proses dibatalkan.");
                            break;
                        }
                        console.error("Error potong klip", err);
                    }
                }

                if (cancelRenderRef.current) {
                    setProcessStatus('Proses Dibatalkan!');
                    setTimeout(() => { setIsProcessing(false); }, 1500);
                } else {
                    setProcessProgress(100);
                    setProcessStatus('Kelar Cuy! Semua klip udah dipotong.');
                    setTimeout(() => {
                        setIsProcessing(false);
                        addToast("Kelar Cuy! Proses potong udah beres.", "success");
                    }, 1000);
                }
            };

            const handlePotongSelected = () => { const selectedClips = clips.filter(c => c.selected); processAndCutClips(selectedClips); };
            const handleHapusTerpilih = () => setClips(clips.filter(c => !c.selected));

            const handleEditTerpilih = () => {
                const selected = clips.filter(c => c.selected);
                if (selected.length > 0) {
                    setEditingClips(selected);
                    setShowCropModal(true);
                }
            };

            const toggleMyClipSelect = (id) => {
                setSelectedMyClips(prev => prev.includes(id) ? prev.filter(cId => cId !== id) : [...prev, id]);
            };

            const isAllMyClipsSelected = cutClips.length > 0 && selectedMyClips.length === cutClips.length;
            const handleToggleAllMyClips = () => {
                if (isAllMyClipsSelected) {
                    setSelectedMyClips([]);
                } else {
                    setSelectedMyClips(cutClips.map(c => c.id));
                }
            };

            const deleteMyClips = async (clipIdsToDelete) => {
                if(clipIdsToDelete.length === 0) return;
                const urlsToDelete = cutClips.filter(c => clipIdsToDelete.includes(c.id)).map(c => c.url);

                try {
                    await fetch('/api/delete_clips', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ urls: urlsToDelete })
                    });

                    setCutClips(prev => prev.filter(c => !clipIdsToDelete.includes(c.id)));
                    setSelectedMyClips(prev => prev.filter(id => !clipIdsToDelete.includes(id)));
                    addToast("Klip berhasil dihapus dari server.", "success");
                } catch(e) {
                    addToast("Gagal menghapus klip.", "error");
                }
            };

            const cancelDownload = (clipId, e) => {
                e.stopPropagation();
                if (abortControllersRef.current[clipId]) {
                    abortControllersRef.current[clipId].abort();
                    delete abortControllersRef.current[clipId];
                }
                setClipDownloadProgresses(prev => { const newProg = {...prev}; delete newProg[clipId]; return newProg; });
            };

            const downloadSingleWithProgress = async (clipId, url, filename) => {
                if (clipDownloadProgresses[clipId] !== undefined) return;
                setClipDownloadProgresses(prev => ({...prev, [clipId]: 0}));

                const controller = new AbortController();
                abortControllersRef.current[clipId] = controller;

                try {
                    const response = await fetch(url, { signal: controller.signal });
                    if (!response.ok) throw new Error("Network response was not ok");

                    const contentLength = response.headers.get('content-length');
                    const total = contentLength ? parseInt(contentLength, 10) : 0;
                    let loaded = 0;

                    const reader = response.body.getReader();
                    const chunks = [];

                    while (true) {
                        const {done, value} = await reader.read();
                        if (done) break;
                        chunks.push(value);
                        loaded += value.length;
                        if (total) {
                            setClipDownloadProgresses(prev => ({...prev, [clipId]: (loaded/total)*100}));
                        }
                    }

                    const blob = new Blob(chunks, { type: 'video/mp4' });
                    const blobUrl = window.URL.createObjectURL(blob);
                    const a = document.createElement('a');
                    a.href = blobUrl;
                    a.download = filename;
                    document.body.appendChild(a);
                    a.click();
                    document.body.removeChild(a);
                    window.URL.revokeObjectURL(blobUrl);

                    setTimeout(() => {
                        setClipDownloadProgresses(prev => {
                            const newProg = {...prev};
                            delete newProg[clipId];
                            return newProg;
                        });
                        delete abortControllersRef.current[clipId];
                    }, 500);
                } catch (err) {
                    if (err.name === 'AbortError') {
                        addToast("Download dibatalkan.", "warning");
                    } else {
                        addToast("Gagal download video.", "error");
                    }
                    setClipDownloadProgresses(prev => { const newProg = {...prev}; delete newProg[clipId]; return newProg; });
                    delete abortControllersRef.current[clipId];
                }
            };

            const downloadSelectedMyClips = async () => {
                if(selectedMyClips.length === 0) return;
                const clipsToDownload = cutClips.filter(c => selectedMyClips.includes(c.id));

                clipsToDownload.forEach(c => {
                    const fname = c.name.endsWith('.mp4') ? c.name : c.name + '.mp4';
                    downloadSingleWithProgress(c.id, c.url, fname);
                });
            };

            const getAspectRatioStyle = () => {
                if (globalRatio === '16:9') return { aspectRatio: '16/9' };
                if (globalRatio === '9:16') return { aspectRatio: '9/16' };
                if (globalRatio === '1:1') return { aspectRatio: '1/1' };
                if (globalRatio === '3:4') return { aspectRatio: '3/4' };
                if (globalRatio === '4:3') return { aspectRatio: '4/3' };
                return { aspectRatio: 'auto' };
            };

            const appProps = {
                appTheme, setAppTheme, cycleTheme,
                currentView, setCurrentView,
                toasts, setToasts, removeToast, addToast, clearAllToasts,
                isServerOnline, setIsServerOnline,
                downloadStatus, setDownloadStatus, downloadProgress, setDownloadProgress,
                isGpuMode, setIsGpuMode, toggleGpuMode,
                isPromptCopied, setIsPromptCopied,
                file, setFile,
                youtubeUrlInput, setYoutubeUrlInput,
                isFetchingUrl, setIsFetchingUrl,
                videoUrl, setVideoUrl, videoIdHash, setVideoIdHash, videoMeta, setVideoMeta,
                duration, setDuration, currentTime, setCurrentTime, isPlaying, setIsPlaying, videoRef,
                globalRatio, setGlobalRatio, globalQuality, setGlobalQuality, engineSpeed, setEngineSpeed,
                clips, _setClips, setClips, pastClips, setPastClips, futureClips, setFutureClips, handleUndo, handleRedo,
                showCropModal, setShowCropModal, editingClips, setEditingClips,
                previewingClipId, setPreviewingClipId,
                cutClips, setCutClips, showMyClipModal, setShowMyClipModal, selectedMyClips, setSelectedMyClips,
                abortControllersRef, clipDownloadProgresses, setClipDownloadProgresses,
                isProcessing, setIsProcessing, processProgress, setProcessProgress, processStatus, setProcessStatus,
                currentProcessIndex, setCurrentProcessIndex, totalProcessCount, setTotalProcessCount, currentClipName, setCurrentClipName,
                showCsvModal, setShowCsvModal, csvText, setCsvText, csvJumlahClip, setCsvJumlahClip, csvDurasiClip, setCsvDurasiClip, csvCatatan, setCsvCatatan,
                history, setHistory,
                isMiniPlayer, setIsMiniPlayer, miniPos, setMiniPos,
                sholatReminder, setSholatReminder, isGeneratingReminder, setIsGeneratingReminder, isReading, setIsReading,
                leftWidth, setLeftWidth, isDragging, setIsDragging,
                containerRef, cancelRenderRef,
                loadSavedClips, loadHistory, handleDragStart, handleSeekAndExtend, generateSholatReminder, readAloud,
                handleTextareaChange, handleYoutubeLoad, loadFromHistory, handleTimeUpdate, handleLoadedMetadata, togglePlay,
                addClip, processCsvData, copyPromptToClipboard, downloadTranscriptDirect, downloadTranscript,
                updateClip, removeClip, toggleSelect, toggleSelectAll, setClipTimeFromPlayer, playPreview,
                processAndCutClips, handlePotongSelected, handleHapusTerpilih, handleEditTerpilih,
                toggleMyClipSelect, isAllMyClipsSelected, handleToggleAllMyClips, deleteMyClips, cancelDownload,
                downloadSingleWithProgress, downloadSelectedMyClips, getAspectRatioStyle
            };

            return (
                <div data-theme={appTheme} className="min-h-screen md:h-screen flex flex-col bg-[#000000] text-zinc-100 font-sans selection:bg-yellow-500/30 overflow-x-hidden md:overflow-hidden relative transition-colors duration-500">

                {/* TOAST SYSTEM CONTAINER */}
                <div className="fixed top-4 left-1/2 -translate-x-1/2 z-[99999] flex flex-col gap-2 pointer-events-none items-center">
                    {toasts.length > 1 && (
                        <button onClick={clearAllToasts} className="pointer-events-auto bg-zinc-800/90 text-zinc-300 text-[10px] font-bold uppercase tracking-wider px-4 py-1.5 rounded-full cursor-pointer hover:text-white hover:bg-zinc-700 mb-1 shadow-lg border border-zinc-700 transition-all active:scale-95">Tutup Semua Notifikasi</button>
                    )}
                    {toasts.map(t => (
                        <div key={t.id} className={t.exiting ? "toast-exit" : "toast-enter"} onClick={() => clearAllToasts()}>
                            <ToastItem t={t} removeToast={removeToast} />
                        </div>
                    ))}
                </div>

                <header className="sticky top-0 w-full h-12 bg-zinc-950 border-b border-zinc-800/50 px-4 flex justify-between items-center z-[999] shrink-0 shadow-md">
                    <div className="flex items-center gap-4">
                        <div className="flex items-center gap-3 text-left group transition-all">
                            <img src="LOGO_PANJANG_PLACEHOLDER" alt="KepKat Logo" onClick={cycleTheme} className="h-7 object-contain drop-shadow-[0_0_8px_rgba(234,179,8,0.3)] group-hover:scale-105 transition-all cursor-pointer" title="Klik untuk ganti tema!" />
                        </div>
                    </div>

                    <div className="flex items-center gap-2 sm:gap-3">
                        <div className="flex items-center gap-2 bg-zinc-900/80 px-2 py-1.5 rounded-lg border border-zinc-800/50">
                            <div className={`w-2 h-2 rounded-full ${isServerOnline ? 'bg-green-500 shadow-[0_0_8px_#22c55e]' : 'bg-red-500 shadow-[0_0_8px_#ef4444] animate-pulse'}`}></div>
                            <span className={`text-[9px] font-bold uppercase tracking-wider ${isServerOnline ? 'text-green-500' : 'text-red-500'}`}>{isServerOnline ? 'Server Online' : 'Server Offline'}</span>
                        </div>
                    </div>
                </header>

                <div ref={containerRef} className="flex-1 flex flex-col md:flex-row relative w-full min-h-0">
                    <HalamanBeranda {...appProps} />
                    <HalamanPotongKlip {...appProps} />
                    <HalamanPreviewKlip {...appProps} />
                    <HalamanEditKlip {...appProps} />
                </div>

                <HalamanMyClips {...appProps} />

                </div>
            );
        }

        const root = createRoot(document.getElementById('root'));
        root.render(<App />);
    </script>
</body>
</html>
"""

def compile_kepkat_ui():
    html_out = core_html_template.replace("FAVICON_PLACEHOLDER", b64_kotak)
    html_out = html_out.replace("LOGO_PANJANG_PLACEHOLDER", b64_panjang)

    ordered_files = [
        "static/pages/beranda.jsx",
        "static/pages/myclips.jsx",
        "static/pages/potong_klip.jsx",
        "static/pages/preview_klip.jsx",
        "static/pages/edit_klip.jsx"
    ]
    extra_files = sorted(glob.glob("static/pages/*.jsx"))
    for ef in extra_files:
        norm_ef = ef.replace("\\", "/")
        if norm_ef not in ordered_files:
            ordered_files.append(norm_ef)

    combined_pages = []
    loaded_names = []
    for pf in ordered_files:
        if os.path.exists(pf):
            with open(pf, "r", encoding="utf-8") as f:
                combined_pages.append(f"// === FILE: {pf} ===\n" + f.read())
            loaded_names.append(os.path.basename(pf))

    all_code_str = "\n\n".join(combined_pages)
    for comp_name in ["HalamanBeranda", "HalamanMyClips", "HalamanPotongKlip", "HalamanPreviewKlip", "HalamanEditKlip", "CropModal"]:
        if f"const {comp_name}" not in all_code_str and f"function {comp_name}" not in all_code_str:
            all_code_str += f"\nconst {comp_name} = () => null;"

    html_out = html_out.replace("// --- INJEKSI_SEMUA_HALAMAN_DI_SINI ---", all_code_str)

    with open("static/index.html", "w", encoding="utf-8") as f:
        f.write(html_out)
    print(f"📦 Halaman tergabung ({len(loaded_names)}): {', '.join(loaded_names)}")

compile_kepkat_ui()
print("✅ CELL 6 (Kerangka Induk & Compiler) berhasil menyatukan semua halaman ke static/index.html!")
