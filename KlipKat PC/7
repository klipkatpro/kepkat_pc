            import whisper
        except ImportError:
            raise Exception("Modul Whisper tidak tersedia karena mode CPU.")

        import tqdm

        model_size = "small"
        if accuracy == "cepat": model_size = "base"
        elif accuracy == "akurat": model_size = "medium"

        gpu_mode = False
        try:
            if subprocess.run(["nvidia-smi"], stdout=subprocess.PIPE, stderr=subprocess.PIPE).returncode == 0:
                gpu_mode = True
        except: pass

        if not gpu_mode and accuracy in ["medium", "akurat"]:
            model_size = "tiny"

        model = whisper.load_model(model_size)
        transcript_tracker[video_id]["progress"] = 15

        orig_tqdm = tqdm.tqdm
        devnull_fp = open(os.devnull, "w")

        class WhisperProgressTqdm(orig_tqdm):
            def __init__(self, *args, **kwargs):
                kwargs["file"] = devnull_fp
                kwargs["disable"] = False
                super().__init__(*args, **kwargs)

            def update(self, n=1):
                if transcript_tracker.get(video_id, {}).get("cancel"):
                    raise Exception("Dibatalkan User")
                res = super().update(n)
                try:
                    if self.total and self.total > 0:
                        pct = 15 + int((self.n / self.total) * 80)
                        if not transcript_tracker.get(video_id, {}).get("cancel"):
                            transcript_tracker[video_id]["progress"] = max(15, min(95, pct))
                except: pass
                return res

        tqdm.tqdm = WhisperProgressTqdm
        try:
            result = model.transcribe(target_audio, verbose=False, fp16=gpu_mode)
        finally:
            tqdm.tqdm = orig_tqdm
            try: devnull_fp.close()
            except: pass

        if transcript_tracker.get(video_id, {}).get("cancel"):
            raise Exception("Dibatalkan User")

        transcript_tracker[video_id]["progress"] = 97

        def format_time(s):
            h, m, sec, ms = int(s // 3600), int((s % 3600) // 60), int(s % 60), int((s - int(s)) * 1000)
            return f"{h:02d}:{m:02d}:{sec:02d},{ms:03d}"

        lines = []
        for i, segment in enumerate(result.get('segments', []), start=1):
            lines.extend([str(i), f"{format_time(segment['start'])} --> {format_time(segment['end'])}", segment['text'].strip(), ""])

        subtitle_text = "\n".join(lines)
        subtitle_text = hapus_milidetik(subtitle_text).strip()

        if not subtitle_text:
            subtitle_text = "1\n00:00:00 --> 00:00:05\n[Tidak ada suara percakapan yang terdeteksi]"

        with open(f"static/raw_videos/{video_id}.srt", "w", encoding="utf-8") as f:
            f.write(subtitle_text)

        for f_cleanup in glob.glob(f"{temp_audio_base}*"):
            try: os.remove(f_cleanup)
            except: pass

        transcript_tracker[video_id] = {"status": "done", "progress": 100, "text": subtitle_text, "cancel": False}

    except Exception as e:
        status_msg = "cancelled" if str(e) == "Dibatalkan User" else "error"
        transcript_tracker[video_id] = {"status": status_msg, "progress": 0, "text": str(e), "cancel": False}
        for f_cleanup in glob.glob(f"{temp_audio_base}*"):
            try: os.remove(f_cleanup)
            except: pass

