                if transcript_tracker.get(video_id, {}).get("cancel"):
                    raise Exception("Dibatalkan User")
                if d.get('status') == 'downloading':
                    try:
                        p_str = d.get('_percent_str', '0.0%')
                        c_str = re.sub(r'\x1B(?:[@-Z\\-_]|\[[0-?]*[ -/]*[@-~])', '', p_str).replace('%', '').strip()
                        p_val = float(c_str)
                        if not transcript_tracker.get(video_id, {}).get("cancel"):
