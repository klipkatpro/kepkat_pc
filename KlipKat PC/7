        try:
            with open(json_path, 'r') as f: meta = json.load(f)

            curr_status = download_tracker.get(video_hash, {}).get("status", "unknown")
            if curr_status != "downloading":
                if os.path.exists(full_video_path): download_tracker[video_hash] = {"status": "done", "progress": 100}
                else:
                    download_tracker[video_hash] = {"status": "downloading", "progress": 0}
                    # DEFAULT CEK VIDEO = KUNCI DI 1080p
                    bg_tasks.add_task(download_video_task, req.url, video_hash, full_video_path, 1080)
            return {
                "video_id": video_hash, "direct_url": "", "status": download_tracker[video_hash]["status"],
                "title": meta.get("title", "KepKat_Video"), "uploader": meta.get("uploader", "Unknown Source"),
                "resolution": meta.get("resolution", "Original"), "size_str": meta.get("size_str", "Unknown"),
                "duration_str": meta.get("duration_str", "Unknown")
            }
        except: pass

    opts_preview = ydl_base_opts.copy()
    try:
        with yt_dlp.YoutubeDL(opts_preview) as ydl:
            info = ydl.extract_info(req.url, download=False)
            best_h = 0
            best_v_size = 0
            for f in info.get('formats', []):
                if f.get('vcodec') != 'none' and f.get('height'):
                    h = f.get('height')
                    if h > best_h: best_h = h; best_v_size = f.get('filesize') or f.get('filesize_approx') or 0
            best_a_size = 0
            for f in info.get('formats', []):
                if f.get('acodec') != 'none' and f.get('vcodec') == 'none':
                    s = f.get('filesize') or f.get('filesize_approx') or 0
                    if s > best_a_size: best_a_size = s
            total_size = best_v_size + best_a_size
            if total_size == 0: total_size = info.get('filesize_approx') or info.get('filesize') or 0

            title = info.get('title', 'KepKat_Video')
            uploader = info.get('uploader', 'Unknown Source')
            thumbnail = info.get('thumbnail', '')

            if best_h >= 2160: res_str = "4K Ultra HD"
            elif best_h >= 1440: res_str = "2K QHD"
            elif best_h >= 1080: res_str = "1080p Full HD"
            elif best_h >= 720: res_str = "720p HD"
            elif best_h >= 480: res_str = "480p SD"
            elif best_h >= 360: res_str = "360p SD"
            else: res_str = f"{best_h}p" if best_h else "Original"

            size_str = f"{total_size / (1024 * 1024):.1f} MB" if total_size > 0 else "Unknown Size"
            duration_sec = info.get('duration', 0)
            def format_dur(secs):
                if not secs: return "0 dtk"
                m, s = divmod(secs, 60); h, m = divmod(m, 60)
                if h > 0: return f"{int(h)}j {int(m)}m {int(s)}d"
                elif m > 0: return f"{int(m)}m {int(s)}d"
                return f"{int(s)} dtk"
            duration_str = format_dur(duration_sec)

            meta = {"title": title, "uploader": uploader, "resolution": res_str, "size_str": size_str, "duration_str": duration_str, "duration_sec": duration_sec, "original_url": req.url, "thumbnail": thumbnail}
            with open(json_path, 'w') as f: json.dump(meta, f)
    except Exception as e:
        raise Exception("Gagal Fetch URL")

    download_tracker[video_hash] = {"status": "downloading", "progress": 0}
    # DEFAULT CEK VIDEO = KUNCI DI 1080p
    bg_tasks.add_task(download_video_task, req.url, video_hash, full_video_path, 1080)

    return {
        "video_id": video_hash, "direct_url": "", "status": "downloading",
        "title": title, "uploader": uploader, "resolution": res_str,
        "size_str": size_str, "duration_str": duration_str
