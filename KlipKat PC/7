@app.post("/api/fetch_transcript_direct")
def fetch_transcript_direct(req: TranscriptDirectReq):
    video_hash = hashlib.md5(req.url.encode()).hexdigest()
    existing_srt = f"static/raw_videos/{video_hash}.srt"

    if os.path.exists(existing_srt) and os.path.getsize(existing_srt) > 10:
        try:
            with open(existing_srt, "r", encoding="utf-8") as f:
                cached_sub = f.read().strip()
            if cached_sub:
                return {"text": cached_sub}
        except:
            pass

    try:
        from youtube_transcript_api import YouTubeTranscriptApi
        from youtube_transcript_api.formatters import SRTFormatter
        match = re.search(r'(?:v=|\/)([0-9A-Za-z_-]{11}).*', req.url)
        yt_vid_id = match.group(1) if match else None
        if yt_vid_id:
            transcript_list = YouTubeTranscriptApi.get_transcript(yt_vid_id, languages=['id', 'en'])
            subtitle_text = SRTFormatter().format_transcript(transcript_list)
            subtitle_text = hapus_milidetik(subtitle_text).strip()
            if subtitle_text:
                with open(existing_srt, "w", encoding="utf-8") as f:
                    f.write(subtitle_text)
                return {"text": subtitle_text}
    except Exception:
        pass

    temp_base = f"static/raw_videos/{video_hash}_direct_temp"
    try:
        cmd_subs = ['yt-dlp', '--write-subs', '--write-auto-subs', '--sub-langs', 'id,en', '--skip-download', '--convert-subs', 'srt', '-o', temp_base]
        if os.path.exists("cookies.txt"): cmd_subs.extend(['--cookies', 'cookies.txt'])
        cmd_subs.append(req.url)
        subprocess.run(cmd_subs, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        found = glob.glob(f"{temp_base}*.srt") + glob.glob(f"{temp_base}*.vtt")
        subtitle_text = ""
        if found:
            with open(found[0], "r", encoding="utf-8") as sf: subtitle_text = sf.read()
            text = re.sub(r'(?i)^WEBVTT[^\n]*\n+', '', subtitle_text)
            text = re.sub(r'^Kind:[^\n]*\n+', '', text, flags=re.MULTILINE)
            text = re.sub(r'^Language:[^\n]*\n+', '', text, flags=re.MULTILINE)
            text = re.sub(r'^Style:[^\n]*\n+', '', text, flags=re.MULTILINE)
            pattern = r'(?:\d+\s*\n)?(\d{2}:\d{2}:\d{2}[.,]\d{3}\s*-->\s*\d{2}:\d{2}:\d{2}[.,]\d{3})[^\n]*\n(.*?)(?=\n\s*\n|\Z)'
            matches = re.finditer(pattern, text, flags=re.DOTALL)
            final_srt, count, prev_lines = [], 1, []
            for m in matches:
                ts = m.group(1).replace('.', ',')
                txt = re.sub(r'<[^>]+>', '', m.group(2).strip()).replace('&nbsp;', ' ').replace(' ', ' ')
                current_lines = [l.strip() for l in txt.split('\n') if l.strip()]
                clean_lines = [l for l in current_lines if l not in prev_lines]
                prev_lines = current_lines
                if clean_lines:
                    final_srt.append(f"{count}\n{ts}\n{chr(10).join(clean_lines)}")
                    count += 1
            subtitle_text = "\n\n".join(final_srt).strip() if final_srt else subtitle_text.strip()
            subtitle_text = hapus_milidetik(subtitle_text)
            for f in found: os.remove(f)

            with open(existing_srt, "w", encoding="utf-8") as f:
                f.write(subtitle_text.strip())

            return {"text": subtitle_text}
        else:
            return JSONResponse(status_code=404, content={"error": "Transcript tidak ditemukan."})
    except Exception as e:
        return JSONResponse(status_code=500, content={"error": str(e)})

