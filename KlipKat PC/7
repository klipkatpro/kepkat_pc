@app.post("/api/cut_single")
def cut_single(req: SingleCutReq):
    global active_ffmpeg_process
    os.makedirs("static/cut_clips", exist_ok=True)
    raw_path = f"static/raw_videos/{req.video_id}.mp4"
    out_name = f"{req.name}_{req.clip_id}.mp4"
    out_path = f"static/cut_clips/{out_name}"
    duration = req.end - req.start
    if duration <= 0: duration = 1

    mode_str = "GPU (NVENC)" if req.gpu_mode else "CPU"

    if req.crop_data and req.crop_data.get('keyframes'):
        temp_dir = f"static/cut_clips/temp_{req.clip_id}"
        try:
            os.makedirs(temp_dir, exist_ok=True)
            base_clip_path = f"{temp_dir}/base_clip.mp4"
            cmd_trim = ["ffmpeg", "-y", "-ss", str(req.start), "-i", raw_path, "-t", str(duration), "-c:v", "libx264", "-preset", "superfast", "-crf", "18", "-c:a", "aac", "-b:a", "128k", "-async", "1", base_clip_path]
            subprocess.run(cmd_trim, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
            if not os.path.exists(base_clip_path): raise Exception("Gagal membuat base clip.")

            scale_heights = {'4k': 2160, '2k': 1440, '1080p': 1080, '720p': 720, '480p': 480, '360p': 360}
            res_target = scale_heights.get(req.quality, 1080)
            if req.ratio == '16:9': cw, ch = int(res_target * 16/9), res_target
            elif req.ratio == '1:1': cw, ch = res_target, res_target
            elif req.ratio == '3:4': cw, ch = res_target, int(res_target * 4/3)
            elif req.ratio == '4:3': cw, ch = int(res_target * 4/3), res_target
            else: cw, ch = res_target, int(res_target * 16/9)
            cw, ch = cw + (cw % 2), ch + (ch % 2)

            def get_layout_slots(layout_name, num_boxes, W, H):
                s = []
                if layout_name in ['1-full', '1-square', '1-landscape'] or num_boxes == 1: s.append((0, 0, W, H))
                elif layout_name == '2-stack' or (num_boxes == 2 and layout_name not in ['2-reaction-top', '2-reaction-bottom']): s.extend([(0, 0, W, H//2), (0, H//2, W, H - H//2)])
                elif layout_name == '2-reaction-top': h1 = int(W * 9/16); s.extend([(0, 0, W, h1), (0, h1, W, H - h1)])
                elif layout_name == '2-reaction-bottom': h1 = H - int(W * 9/16); s.extend([(0, 0, W, h1), (0, h1, W, H - h1)])
