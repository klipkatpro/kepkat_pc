            for m in matches:
                ts = m.group(1).replace('.', ',')
                txt = re.sub(r'<[^>]+>', '', m.group(2).strip()).replace('&nbsp;', ' ').replace(' ', ' ')
                current_lines = [l.strip() for l in txt.split('\n') if l.strip()]
