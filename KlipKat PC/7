def android_process_workflow(req: ProcessVideoReq, video_hash: str, quality: str, ratio: str, speed: str):
    try:
        video_url = req.videoUrl.strip()
        android_jobs[video_hash]["status"] = "downloading"
        full_video_path = f"static/raw_videos/{video_hash}.mp4"
        json_path = f"static/raw_videos/{video_hash}.json"

        target_h = 1080
        if quality == "4k": target_h = 2160
        elif quality == "2k": target_h = 1440
        elif quality == "original": target_h = 9999
        elif quality == "720p": target_h = 720
        elif quality == "480p": target_h = 480
        elif quality == "360p": target_h = 360

        current_dl_h = 1080
        if os.path.exists(json_path):
            try:
                with open(json_path, 'r') as f: meta = json.load(f)
                current_dl_h = meta.get("downloaded_height", 1080)
            except: pass

        need_redownload = False
        if target_h > current_dl_h:
            need_redownload = True

        if need_redownload and os.path.exists(full_video_path):
            try: os.remove(full_video_path)
            except: pass

        wait_time = 0
        while True:
            dl_status = download_tracker.get(video_hash, {}).get("status", "unknown")
            if dl_status == "downloading" and not need_redownload:
                time.sleep(2)
                wait_time += 2
                if wait_time > 1800:
                    raise Exception("Timeout menunggu download")
            elif dl_status == "blocked":
                raise Exception("BLOCKED")
            elif dl_status == "error":
                raise Exception("Error download di latar belakang")
            else:
                break

        if not os.path.exists(full_video_path):
            download_video_task(video_url, video_hash, full_video_path, max_height=target_h)
            if download_tracker.get(video_hash, {}).get("status") == "blocked": raise Exception("BLOCKED")
            if not os.path.exists(full_video_path): raise Exception("Gagal mengunduh video")
        else:
            download_tracker[video_hash] = {"status": "done", "progress": 100}

        android_jobs[video_hash]["status"] = "processing"
        gpu_mode = False
        try:
            if subprocess.run(["nvidia-smi"], stdout=subprocess.PIPE, stderr=subprocess.PIPE).returncode == 0: gpu_mode = True
        except: pass

        android_jobs[video_hash]["params"]["gpu_mode"] = gpu_mode

        for clip in req.clips:
            if android_jobs[video_hash].get("status") == "cancelled": break

            android_jobs[video_hash]["clips"][clip.id]["status"] = "processing"
            cut_req = SingleCutReq(
                video_id=video_hash, start=clip.start, end=clip.end, name=clip.name,
                quality=quality, ratio=ratio, clip_id=clip.id, gpu_mode=gpu_mode, engine_speed=speed
            )
            try:
                res_cut = cut_single(cut_req)
                android_jobs[video_hash]["clips"][clip.id]["status"] = "done"
                android_jobs[video_hash]["clips"][clip.id]["progress"] = 100
                android_jobs[video_hash]["clips"][clip.id]["url"] = res_cut["clip"]["url"]
            except Exception as e:
                if "Dibatalkan User" in str(e): android_jobs[video_hash]["clips"][clip.id]["status"] = "cancelled"
                else:
                    android_jobs[video_hash]["clips"][clip.id]["status"] = "error"

        if android_jobs[video_hash]["status"] != "cancelled":
            android_jobs[video_hash]["status"] = "done"
    except Exception as e:
        if str(e) == "BLOCKED": android_jobs[video_hash]["status"] = "blocked"
        else:
            android_jobs[video_hash]["status"] = "error"

@app.post("/process_video")
def process_video(req: ProcessVideoReq, bg_tasks: BackgroundTasks):
    video_url = req.videoUrl.strip()
    if not video_url: return JSONResponse(status_code=400, content={"error": "Link kosong"})

    video_hash = hashlib.md5(video_url.encode()).hexdigest()

    clip_tracker = {}
    for c in req.clips:
        clip_tracker[c.id] = {"status": "pending", "progress": 0, "url": "", "start": c.start, "end": c.end, "name": c.name}

    quality = "original"
    if "360p" in req.resolution: quality = "360p"
    elif "480p" in req.resolution: quality = "480p"
    elif "720p" in req.resolution: quality = "720p"
    elif "1080p" in req.resolution: quality = "1080p"
    elif "1440p" in req.resolution: quality = "2k"
    elif "2160p" in req.resolution: quality = "4k"
    ratio = "original"
    if "16:9" in req.aspectRatio: ratio = "16:9"
    elif "9:16" in req.aspectRatio: ratio = "9:16"
    elif "1:1" in req.aspectRatio: ratio = "1:1"
    elif "4:3" in req.aspectRatio: ratio = "4:3"
    elif "3:4" in req.aspectRatio: ratio = "3:4"
    speed = "fast"
    if "Ultrafast" in req.engineSpeed: speed = "ultrafast"
    elif "Slow" in req.engineSpeed: speed = "slow"

    android_jobs[video_hash] = {
        "status": "preparing",
        "download_progress": 0,
        "clips": clip_tracker,
        "params": {"quality": quality, "ratio": ratio, "speed": speed}
    }

    bg_tasks.add_task(android_process_workflow, req, video_hash, quality, ratio, speed)
    return {"status": "success", "video_hash": video_hash}

