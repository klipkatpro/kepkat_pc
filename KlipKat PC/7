def hapus_milidetik(text_input):
    def bulatkan(match):
        def parse_sec(ts):
            h, m, s_ms = ts.replace('.', ',').split(':')
            s, ms = s_ms.split(',')
            return int(h)*3600 + int(m)*60 + int(s) + int(ms)/1000.0
        def to_str(sec): return f"{int(sec//3600):02d}:{int((sec%3600)//60):02d}:{int(sec%60):02d}"
        return f"{to_str(math.floor(parse_sec(match.group(1))))} --> {to_str(math.ceil(parse_sec(match.group(2))))}"
    return re.sub(r'(\d{2}:\d{2}:\d{2}[.,]\d{3})\s*-->\s*(\d{2}:\d{2}:\d{2}[.,]\d{3})', bulatkan, text_input)

