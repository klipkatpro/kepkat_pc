    def log_terminal(msg):
        clean_msg = re.compile(r'\x1B(?:[@-Z\-_]|\[[0-?]*[ -/]*[@-~])').sub('', str(msg))

        color = "#71717a"
        if any(k in clean_msg for k in ["[SUCCESS]", "[DONE]", "berhasil", "optimal", "maksimal"]): color = "#3b82f6"
        elif any(k in clean_msg for k in ["[ERROR]", "[BLOCKED]", "[DELETED]", "Gagal", "FATAL"]): color = "#ef4444"
        elif any(k in clean_msg for k in ["[WARNING]", "[AWAS]", "Melewati"]): color = "#f97316"
        elif any(k in clean_msg for k in ["[KLIPKAT-INIT]", "[KLIPKAT-SYS]", "[KLIPKAT-NET]", "Menyiapkan", "Memulai"]): color = "#22c55e"

        msg_escaped = html.escape(clean_msg).replace('\n', '<br>').replace('"', '\\"').replace("'", "\\'")
        js_code = f"""
        var term = document.getElementById('hacker-terminal');
        if(term) {{
            var newDiv = document.createElement('div');
            newDiv.style.color = '{color}';
            newDiv.innerHTML = '{msg_escaped}';
            term.appendChild(newDiv);
            term.scrollTop = term.scrollHeight;
        }}
        """
        display(Javascript(js_code))

    def run_cmd_log(cmd, desc):
        log_terminal(f"[KLIPKAT-SYS] Memulai proses: {desc}...")
        try:
            proc = subprocess.Popen(cmd, shell=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
            for line in proc.stdout:
                clean_line = line.strip()
                if clean_line:
                    log_terminal(f"[LOG] {clean_line}")
            proc.wait()
            if proc.returncode == 0:
                log_terminal(f"[SUCCESS] {desc} selesai.")
            else:
                log_terminal(f"[ERROR] {desc} selesai dengan peringatan/error (Kode: {proc.returncode}).")
        except Exception as e:
            log_terminal(f"[ERROR] Gagal menjalankan {desc}: {e}")

