    @app.get("/api/get_my_clips")
    def get_my_clips():
        clips = []
        if os.path.exists("static/cut_clips"):
            for f in sorted(os.listdir("static/cut_clips"), key=lambda x: os.path.getmtime(os.path.join("static/cut_clips", x)), reverse=True):
                if f.endswith(".mp4"):
                    parts = f.rsplit("_", 1)
                    if len(parts) == 2:
                        name, clip_id_ext = parts
                        clip_id = clip_id_ext.replace(".mp4", "")

                        filepath = os.path.join("static/cut_clips", f)
                        try:
                            mtime = os.path.getmtime(filepath)
                            size_bytes = os.path.getsize(filepath)
                            if size_bytes < 1024 * 1024:
                                size_str = f"{size_bytes / 1024:.1f} KB"
                            else:
                                size_str = f"{size_bytes / (1024 * 1024):.1f} MB"
                        except:
                            size_str = "0 KB"
                            mtime = time.time()

                        clips.append({"id": clip_id, "name": name, "url": f"/static/cut_clips/{f}?t={int(mtime)}", "size": size_str})
        return {"clips": clips}

    @app.get("/api/get_history")
    def get_history():
        history = []
        if os.path.exists("static/raw_videos"):
            files = glob.glob("static/raw_videos/*.json")
            files.sort(key=os.path.getmtime, reverse=True)
            for f in files:
                try:
                    with open(f, 'r') as fp:
                        meta = json.load(fp)
                    meta['video_id'] = os.path.basename(f).replace('.json', '')
                    history.append(meta)
                except: pass
        return {"history": history}

    @app.post("/api/fetch_transcript_direct")
    def fetch_transcript_direct(req: TranscriptDirectReq):
        video_hash = hashlib.md5(req.url.encode()).hexdigest()
        temp_base = f"static/raw_videos/{video_hash}_direct_temp"
        try:
            cmd_subs = ['yt-dlp', '--write-subs', '--write-auto-subs', '--sub-langs', 'id,en', '--skip-download', '--convert-subs', 'srt', '-o', temp_base]
            if os.path.exists("cookies.txt"):
                cmd_subs.extend(['--cookies', 'cookies.txt'])
            cmd_subs.append(req.url)

            subprocess.run(cmd_subs, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            found = glob.glob(f"{temp_base}*.srt") + glob.glob(f"{temp_base}*.vtt")
            subtitle_text = ""
            if found:
                with open(found[0], "r", encoding="utf-8") as sf:
                    subtitle_text = sf.read()

                text = re.sub(r'(?i)^WEBVTT[^\n]*\n+', '', subtitle_text)
                text = re.sub(r'^Kind:[^\n]*\n+', '', text, flags=re.MULTILINE)
                text = re.sub(r'^Language:[^\n]*\n+', '', text, flags=re.MULTILINE)
                text = re.sub(r'^Style:[^\n]*\n+', '', text, flags=re.MULTILINE)
                pattern = r'(?:\d+\s*\n)?(\d{2}:\d{2}:\d{2}[.,]\d{3}\s*-->\s*\d{2}:\d{2}:\d{2}[.,]\d{3})[^\n]*\n(.*?)(?=\n\s*\n|\Z)'
                matches = re.finditer(pattern, text, flags=re.DOTALL)
                final_srt, count, prev_lines = [], 1, []
                for m in matches:
                    ts = m.group(1).replace('.', ',')
                    txt = re.sub(r'<[^>]+>', '', m.group(2).strip()).replace('&nbsp;', ' ').replace(' ', ' ')
                    current_lines = [l.strip() for l in txt.split('\n') if l.strip()]
                    clean_lines = [l for l in current_lines if l not in prev_lines]
                    prev_lines = current_lines
                    if clean_lines:
                        final_srt.append(f"{count}\n{ts}\n{chr(10).join(clean_lines)}")
                        count += 1

                subtitle_text = "\n\n".join(final_srt).strip() if final_srt else subtitle_text.strip()

                def hapus_milidetik(text_input):
                    def bulatkan(match):
                        def parse_sec(ts):
                            h, m, s_ms = ts.replace('.', ',').split(':')
                            s, ms = s_ms.split(',')
                            return int(h)*3600 + int(m)*60 + int(s) + int(ms)/1000.0
                        def to_str(sec): return f"{int(sec//3600):02d}:{int((sec%3600)//60):02d}:{int(sec%60):02d}"
                        return f"{to_str(math.floor(parse_sec(match.group(1))))} --> {to_str(math.ceil(parse_sec(match.group(2))))}"
                    return re.sub(r'(\d{2}:\d{2}:\d{2}[.,]\d{3})\s*-->\s*(\d{2}:\d{2}:\d{2}[.,]\d{3})', bulatkan, text_input)

                subtitle_text = hapus_milidetik(subtitle_text)

                for f in found:
                    os.remove(f)
                return {"text": subtitle_text}
            else:
                return JSONResponse(status_code=404, content={"error": "Transcript tidak ditemukan."})
        except Exception as e:
            return JSONResponse(status_code=500, content={"error": str(e)})


