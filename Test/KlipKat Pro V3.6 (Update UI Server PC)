    def cut_single(req: SingleCutReq):
        global active_ffmpeg_process
        raw_path = f"static/raw_videos/{req.video_id}.mp4"
        out_name = f"{req.name}_{req.clip_id}.mp4"
        out_path = f"static/cut_clips/{out_name}"

        duration = req.end - req.start
        if duration <= 0: duration = 1

        mode_str = "GPU (NVENC)" if req.gpu_mode else "CPU"
        log_terminal(f"[KLIPKAT-SYS] [CUTTING] Mengeksekusi instruksi: {out_name} | Engine: {mode_str} | Gear: {req.engine_speed.upper()} | Range: {duration}s")

        vf_filters = []
        if req.quality != 'original':
            scale_heights = {'4k': 2160, '2k': 1440, '1080p': 1080, '720p': 720, '480p': 480, '360p': 360}
            if req.quality in scale_heights:
                vf_filters.append(f"scale=-2:{scale_heights[req.quality]}")

        if req.ratio != 'original':
            if req.ratio == '16:9': vf_filters.append("crop=ih*16/9:ih")
            elif req.ratio == '9:16': vf_filters.append("crop=ih*9/16:ih")
            elif req.ratio == '1:1': vf_filters.append("crop=ih:ih")
            elif req.ratio == '3:4': vf_filters.append("crop=ih*3/4:ih")
            elif req.ratio == '4:3': vf_filters.append("crop=ih*4/3:ih")

        vf = ",".join(vf_filters) if vf_filters else ""

        cmd = [
            "ffmpeg", "-y",
            "-ss", str(req.start),
            "-i", raw_path,
            "-t", str(duration)
        ]

        speed = req.engine_speed
        if req.gpu_mode:
            if speed == "ultrafast":
                cmd.extend(["-c:v", "h264_nvenc", "-preset", "p1", "-rc", "vbr", "-cq", "28", "-b:v", "0", "-c:a", "aac", "-b:a", "128k"])
            elif speed == "slow":
                cmd.extend(["-c:v", "h264_nvenc", "-preset", "p7", "-rc", "vbr", "-cq", "23", "-b:v", "0", "-c:a", "aac", "-b:a", "128k"])
            else:
                cmd.extend(["-c:v", "h264_nvenc", "-preset", "p4", "-rc", "vbr", "-cq", "26", "-b:v", "0", "-c:a", "aac", "-b:a", "128k"])
        else:
            if speed == "ultrafast":
                cmd.extend(["-c:v", "libx264", "-preset", "ultrafast", "-crf", "28", "-c:a", "aac", "-b:a", "128k", "-threads", "4"])
            elif speed == "slow":
                cmd.extend(["-c:v", "libx264", "-preset", "medium", "-crf", "23", "-c:a", "aac", "-b:a", "128k", "-threads", "4"])
            else:
                cmd.extend(["-c:v", "libx264", "-preset", "superfast", "-crf", "26", "-c:a", "aac", "-b:a", "128k", "-threads", "4"])

        if vf:
            cmd.extend(["-vf", vf])
        cmd.append(out_path)

        cut_tracker[req.clip_id] = 0
        active_ffmpeg_process = subprocess.Popen(cmd, stderr=subprocess.PIPE, universal_newlines=True)

        fallback_to_cpu = False
        for line in active_ffmpeg_process.stderr:
            if "Unknown encoder" in line and "nvenc" in line.lower():
                fallback_to_cpu = True
                break

            if "time=" in line:
                try:
                    time_str = line.split("time=")[1].split(" ")[0]
                    h, m, s = time_str.split(":")
                    secs = int(h)*3600 + int(m)*60 + float(s)
                    pct = (secs / duration) * 100
                    cut_tracker[req.clip_id] = min(99, pct)
                except:
                    pass

        active_ffmpeg_process.wait()

        if fallback_to_cpu or active_ffmpeg_process.returncode != 0:
            if active_ffmpeg_process.returncode == -9:
                log_terminal(f"[KLIPKAT-SYS] [WARNING] Proses dibatalkan oleh master paksa.")
                raise Exception("Dibatalkan User")

            if fallback_to_cpu:
                log_terminal(f"[KLIPKAT-SYS] [WARNING] Engine GPU gagal! Fallback ke CPU untuk {out_name}")
            else:
                log_terminal(f"[KLIPKAT-SYS] [WARNING] Render error. Fallback ke CPU untuk {out_name}")

            cmd_fallback = [
                "ffmpeg", "-y",
                "-ss", str(req.start),
                "-i", raw_path,
                "-t", str(duration)
            ]

            if speed == "ultrafast":
                cmd_fallback.extend(["-c:v", "libx264", "-preset", "ultrafast", "-crf", "28", "-c:a", "aac", "-b:a", "128k", "-threads", "4"])
            elif speed == "slow":
                cmd_fallback.extend(["-c:v", "libx264", "-preset", "medium", "-crf", "23", "-c:a", "aac", "-b:a", "128k", "-threads", "4"])
            else:
                cmd_fallback.extend(["-c:v", "libx264", "-preset", "superfast", "-crf", "26", "-c:a", "aac", "-b:a", "128k", "-threads", "4"])

            if vf: cmd_fallback.extend(["-vf", vf])
            cmd_fallback.append(out_path)

            active_ffmpeg_process = subprocess.Popen(cmd_fallback, stderr=subprocess.PIPE, universal_newlines=True)
            for line in active_ffmpeg_process.stderr:
                if "time=" in line:
                    try:
                        time_str = line.split("time=")[1].split(" ")[0]
                        h, m, s = time_str.split(":")
                        secs = int(h)*3600 + int(m)*60 + float(s)
                        pct = (secs / duration) * 100
                        cut_tracker[req.clip_id] = min(99, pct)
                    except:
                        pass
            active_ffmpeg_process.wait()

            if active_ffmpeg_process.returncode != 0:
                if active_ffmpeg_process.returncode == -9:
                    log_terminal(f"[KLIPKAT-SYS] [WARNING] Proses dibatalkan paksa.")
                    raise Exception("Dibatalkan User")
                log_terminal(f"[KLIPKAT-SYS] [ERROR] Eksekusi potongan gagal untuk: {out_name}")
                raise Exception("Engine Error")

        cut_tracker[req.clip_id] = 100
        log_terminal(f"[KLIPKAT-SYS] [SUCCESS] Eksekusi selesai: {out_name}")
        active_ffmpeg_process = None
        return {"clip": {"id": req.clip_id, "name": req.name, "url": f"/{out_path}"}}

