            if res.returncode == 0:
                log_terminal("[KLIPKAT-SYS] [INFO] GPU Terdeteksi di mesin Colab.")
                return {"gpu": True}
            log_terminal("[KLIPKAT-SYS] [INFO] GPU Tidak Terdeteksi.")
