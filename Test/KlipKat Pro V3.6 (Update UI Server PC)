            }
            @keyframes toastOut {
                0% { transform: translateY(0) scale(1); opacity: 1; }
                100% { transform: translateY(-150%) scale(0.9); opacity: 0; }
            }
            @keyframes fire-glow {
                0% { box-shadow: 0 0 15px #facc15, inset 0 0 15px #facc15; border-color: #facc15; }
                50% { box-shadow: 0 0 30px #eab308, inset 0 0 25px #eab308; border-color: #eab308; }
                100% { box-shadow: 0 0 15px #facc15, inset 0 0 15px #facc15; border-color: #facc15; }
            }
            .gpu-fire { animation: fire-glow 2s infinite; }
            .gpu-text-fire { background: linear-gradient(to right, #facc15, #eab308, #ca8a04); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
        </style>
    </head>
    <body class="bg-[#000000] text-zinc-100 relative">
        <div id="root"></div>
        <script type="text/babel" data-type="module">
            import React, { useState, useRef, useEffect } from 'react';
            import { createRoot } from 'react-dom/client';
            import { Upload, Play, Pause, Scissors, Download, Plus, Trash2, CheckSquare, Square, Settings, FileVideo, Clock, Eye, X, Sparkles, Coffee, FileSpreadsheet, FileDown, UploadCloud, ClipboardPaste, Info, ShoppingCart, BookOpen, RefreshCw, Copy, Check, Youtube, Instagram, Minus, List, Link, Rewind, FastForward, Maximize, SkipBack, SkipForward, Minimize, ArrowLeft, LayoutGrid, CheckCircle2, AlertTriangle, XCircle, Activity, Move, Flame, Bot, BrainCircuit, ChevronDown, Undo, Redo, Edit } from 'lucide-react';

            const generateId = () => 'clip_' + Date.now().toString(36) + '_' + Math.random().toString(36).substr(2, 9);

            const formatDurationDisplay = (totalSeconds) => {
                if (isNaN(totalSeconds) || !isFinite(totalSeconds) || totalSeconds < 0) return "0 dtk";
                const s = Math.floor(totalSeconds);
                if (s < 60) return `${s} dtk`;
                const m = Math.floor(s / 60);
                const remS = s % 60;
                return remS > 0 ? `${m} mnt ${remS} dtk` : `${m} mnt`;
            };

            const formatTimeCompact = (totalSeconds) => {
                if (isNaN(totalSeconds) || !isFinite(totalSeconds) || totalSeconds < 0) return "00:00";
                const s = Math.floor(totalSeconds);
                const m = Math.floor(s / 60);
                const remS = s % 60;
                const h = Math.floor(m / 60);
                const remM = m % 60;
                if (h > 0) return `${h}:${remM.toString().padStart(2, '0')}:${remS.toString().padStart(2, '0')}`;
                return `${remM.toString().padStart(2, '0')}:${remS.toString().padStart(2, '0')}`;
            };

            const TimeInput = ({ clip, type, updateClip }) => {
                const val = type === 'start' ? clip.start : clip.end;

                const [h, setH] = useState(Math.floor(val / 3600).toString());
                const [m, setM] = useState(Math.floor((val % 3600) / 60).toString());
                const [s, setS] = useState(Math.floor(val % 60).toString());

                useEffect(() => {
                    setH(Math.floor(val / 3600).toString());
                    setM(Math.floor((val % 3600) / 60).toString());
                    setS(Math.floor(val % 60).toString());
                }, [val]);

                const handleBlur = () => {
                    const newH = parseInt(h) || 0;
                    const newM = parseInt(m) || 0;
                    const newS = parseInt(s) || 0;
                    const totalSeconds = (newH * 3600) + (newM * 60) + newS;
                    updateClip(clip.id, type, totalSeconds);
                };

                const handleKeyDown = (e) => {
                    if (e.key === 'Enter') {
                    e.target.blur();
                    }
                };

                return (
                    <div className="flex items-center gap-1 mt-1">
                    <div className="flex flex-col flex-1">
                        <span className="text-[8px] text-zinc-500 font-bold uppercase tracking-wider mb-0.5 text-center">Jam</span>
                        <input type="number" min="0" value={h} onChange={e => setH(e.target.value)} onBlur={handleBlur} onKeyDown={handleKeyDown} className="w-full bg-black/50 border border-zinc-700 focus:border-yellow-500 focus:ring-1 focus:ring-yellow-500 rounded text-center text-xs py-1 text-zinc-100 outline-none transition-all font-mono active:scale-95" />
                    </div>
                    <span className="text-zinc-500 mt-4 font-bold">:</span>
                    <div className="flex flex-col flex-1">
                        <span className="text-[8px] text-zinc-500 font-bold uppercase tracking-wider mb-0.5 text-center">Mnt</span>
                        <input type="number" min="0" max="59" value={m} onChange={e => setM(e.target.value)} onBlur={handleBlur} onKeyDown={handleKeyDown} className="w-full bg-black/50 border border-zinc-700 focus:border-yellow-500 focus:ring-1 focus:ring-yellow-500 rounded text-center text-xs py-1 text-zinc-100 outline-none transition-all font-mono active:scale-95" />
                    </div>
                    <span className="text-zinc-500 mt-4 font-bold">:</span>
                    <div className="flex flex-col flex-1">
                        <span className="text-[8px] text-zinc-500 font-bold uppercase tracking-wider mb-0.5 text-center">Dtk</span>
                        <input type="number" min="0" max="59" value={s} onChange={e => setS(e.target.value)} onBlur={handleBlur} onKeyDown={handleKeyDown} className="w-full bg-black/50 border border-zinc-700 focus:border-yellow-500 focus:ring-1 focus:ring-yellow-500 rounded text-center text-xs py-1 text-zinc-100 outline-none transition-all font-mono active:scale-95" />
                    </div>
                    </div>
                );
            };

            const ToastItem = ({ t, removeToast }) => {
                const [offset, setOffset] = useState(0);
                const [isDragging, setIsDragging] = useState(false);
                const startX = useRef(0);

                const handlePointerDown = (e) => {
                    setIsDragging(true);
                    startX.current = e.clientX;
                    e.target.setPointerCapture(e.pointerId);
                };

                const handlePointerMove = (e) => {
                    if(!isDragging) return;
                    const currentX = e.clientX;
                    setOffset(currentX - startX.current);
                };

                const handlePointerUp = (e) => {
                    setIsDragging(false);
                    e.target.releasePointerCapture(e.pointerId);
                    if (Math.abs(offset) > 100) {
                        removeToast(t.id);
                    } else {
                        setOffset(0);
                    }
                };

                return (
                    <div
                        onPointerDown={handlePointerDown}
                        onPointerMove={handlePointerMove}
                        onPointerUp={handlePointerUp}
                        onPointerCancel={handlePointerUp}
                        className={`pointer-events-auto flex items-center gap-3 px-6 py-3.5 rounded-xl shadow-2xl border cursor-grab active:cursor-grabbing transition-transform duration-200 ${isDragging ? 'duration-0' : ''} ${t.type==='error'?'bg-red-950/90 border-red-900 text-red-200': t.type==='success'?'bg-emerald-950/90 border-emerald-900 text-emerald-200': t.type==='warning'?'bg-amber-950/90 border-amber-900 text-amber-200':'bg-zinc-900/90 border-zinc-800 text-zinc-200'} backdrop-blur-md`}
                        style={{ transform: `translateX(${offset}px)` }}
                    >
                        {t.type === 'error' && <AlertTriangle size={18} className="text-red-500 shrink-0" />}
                        {t.type === 'success' && <CheckCircle2 size={18} className="text-emerald-500 shrink-0" />}
                        {t.type === 'warning' && <Info size={18} className="text-amber-500 shrink-0" />}
                        {t.type === 'info' && <Activity size={18} className="text-yellow-500 shrink-0" />}
                        <span className="text-xs font-bold uppercase tracking-wider drop-shadow-md">{t.msg}</span>
                    </div>
                );
            };

            const CustomSelect = ({ value, options, onChange, label }) => {
                const [isOpen, setIsOpen] = useState(false);
                const wrapperRef = useRef(null);

                useEffect(() => {
                    const handleClickOutside = (e) => { if (wrapperRef.current && !wrapperRef.current.contains(e.target)) setIsOpen(false); };
                    document.addEventListener('mousedown', handleClickOutside);
                    return () => document.removeEventListener('mousedown', handleClickOutside);
                }, []);

                const selectedLabel = options.find(o => o.value === value)?.label || value;
                return (
                    <div ref={wrapperRef} className="relative w-full">
                        <div onClick={() => setIsOpen(!isOpen)} className="w-full bg-black/50 border border-zinc-800 rounded p-1.5 text-[10px] cursor-pointer flex justify-between items-center font-medium text-zinc-300 hover:border-yellow-500 transition-all">
                            <span className="truncate">{selectedLabel}</span>
                            <ChevronDown size={12} className={`transition-transform ${isOpen ? 'rotate-180' : ''}`} />
                        </div>
                        {isOpen && (
                            <div className="absolute top-full left-0 right-0 mt-1 bg-[#000000] border-2 border-zinc-700 rounded shadow-2xl z-[9999] max-h-40 overflow-y-auto custom-scrollbar opacity-100">
                                {options.map(opt => (
                                    <div key={opt.value} onClick={() => { onChange(opt.value); setIsOpen(false); }} className={`px-2 py-1.5 text-[10px] cursor-pointer transition-colors ${value === opt.value ? 'bg-yellow-500/10 text-yellow-500 font-bold' : 'text-zinc-300 hover:bg-yellow-500/20 hover:text-yellow-400'}`}>
                                        {opt.label}
                                    </div>
                                ))}
                            </div>
                        )}
                    </div>
                );
            };

            function App() {
                const [appTheme, setAppTheme] = useState('yellow');
                const [currentView, setCurrentView] = useState('home');

                const cycleTheme = () => {
                    setAppTheme(prev => {
                        if(prev === 'yellow') return 'main';
                        if(prev === 'main') return 'red';
                        if(prev === 'red') return 'green';
                        return 'yellow';
                    });
                };

                const [toasts, setToasts] = useState([]);
                const [isServerOnline, setIsServerOnline] = useState(true);
                const [downloadStatus, setDownloadStatus] = useState('idle');
                const [downloadProgress, setDownloadProgress] = useState(0);

                const [isGpuMode, setIsGpuMode] = useState(false);
                const [isPromptCopied, setIsPromptCopied] = useState(false);

                const removeToast = (id) => {
                    setToasts(prev => prev.map(t => t.id === id ? {...t, exiting: true} : t));
                    setTimeout(() => {
                        setToasts(prev => prev.filter(t => t.id !== id));
                    }, 400);
                };

                const addToast = (msg, type='info') => {
                    const id = Date.now() + Math.random();
                    setToasts(prev => {
                        let list = [...prev, {id, msg, type, exiting: false}];
                        if(list.length > 4) {
                            list = list.slice(list.length - 4);
                        }
                        return list;
                    });
                    setTimeout(() => removeToast(id), 5000);
                };

                const clearAllToasts = () => {
                    setToasts(prev => prev.map(t => ({...t, exiting: true})));
                    setTimeout(() => setToasts([]), 400);
                };

                const toggleGpuMode = async () => {
                    if (!isGpuMode) {
                        addToast("Mengecek ketersediaan GPU di Server...", "info");
                        try {
                            const res = await fetch('/api/check_gpu');
                            const data = await res.json();
                            if (data.gpu) {
                                setIsGpuMode(true);
                                addToast("Mode GPU Diaktifkan! Render secepat kilat🔥", "success");
                            } else {
                                addToast("GPU tidak terdeteksi! Mengalihkan ke CPU.", "error");
                                setIsGpuMode(false);
                            }
                        } catch(e) {
                            addToast("Gagal mengecek GPU.", "error");
                        }
                    } else {
                        setIsGpuMode(false);
                        addToast("Mode GPU Dimatikan. Beralih ke CPU.", "info");
                    }
                };

                const [file, setFile] = useState(null);
                const [youtubeUrlInput, setYoutubeUrlInput] = useState('');
                const [isFetchingUrl, setIsFetchingUrl] = useState(false);

                const [videoUrl, setVideoUrl] = useState(null);
                const [videoIdHash, setVideoIdHash] = useState(null);
                const [videoMeta, setVideoMeta] = useState(null);

                const [duration, setDuration] = useState(0);
                const [currentTime, setCurrentTime] = useState(0);
                const [isPlaying, setIsPlaying] = useState(false);
                const videoRef = useRef(null);

                const [globalRatio, setGlobalRatio] = useState('original');
                const [globalQuality, setGlobalQuality] = useState('1080p');
                const [engineSpeed, setEngineSpeed] = useState('fast');

                // KUSTOMISASI STATE UNDO/REDO UNTUK CLIPS
                const [clips, _setClips] = useState([]);
                const [pastClips, setPastClips] = useState([]);
                const [futureClips, setFutureClips] = useState([]);

                const setClips = (newClips) => {
                    _setClips(prev => {
                        const nextClips = typeof newClips === 'function' ? newClips(prev) : newClips;
                        setPastClips(p => {
                            const newPast = [...p, prev];
                            if (newPast.length > 50) return newPast.slice(newPast.length - 50);
                            return newPast;
                        });
                        setFutureClips([]);
                        return nextClips;
                    });
                };

                const handleUndo = () => {
                    if (pastClips.length === 0) return;
                    const previous = pastClips[pastClips.length - 1];
                    setPastClips(p => p.slice(0, p.length - 1));
                    setFutureClips(f => [clips, ...f]);
                    _setClips(previous);
                };

                const handleRedo = () => {
                    if (futureClips.length === 0) return;
                    const next = futureClips[0];
                    setFutureClips(f => f.slice(1));
                    setPastClips(p => [...p, clips]);
                    _setClips(next);
                };

                const [previewingClipId, setPreviewingClipId] = useState(null);

                const [cutClips, setCutClips] = useState([]);
                const [showMyClipModal, setShowMyClipModal] = useState(false);
                const [selectedMyClips, setSelectedMyClips] = useState([]);

                const abortControllersRef = useRef({});
                const [clipDownloadProgresses, setClipDownloadProgresses] = useState({});

                const [isProcessing, setIsProcessing] = useState(false);
                const [processProgress, setProcessProgress] = useState(0);
                const [processStatus, setProcessStatus] = useState('');
                const [currentProcessIndex, setCurrentProcessIndex] = useState(0);
                const [totalProcessCount, setTotalProcessCount] = useState(0);
                const [currentClipName, setCurrentClipName] = useState('');

                const [showCsvModal, setShowCsvModal] = useState(false);
                const [csvText, setCsvText] = useState('');
                const [csvJumlahClip, setCsvJumlahClip] = useState('10');
                const [csvDurasiClip, setCsvDurasiClip] = useState('1');
                const [csvCatatan, setCsvCatatan] = useState('');

                const [history, setHistory] = useState([]);

                const [isMiniPlayer, setIsMiniPlayer] = useState(false);
                const [miniPos, setMiniPos] = useState({ x: 20, y: 80 });

                const [sholatReminder, setSholatReminder] = useState('');
                const [isGeneratingReminder, setIsGeneratingReminder] = useState(false);
                const [isReading, setIsReading] = useState(false);

                const [leftWidth, setLeftWidth] = useState(40);
                const [isDragging, setIsDragging] = useState(false);

                const containerRef = useRef(null);
                const cancelRenderRef = useRef(false);

                useEffect(() => {
                    if(window.innerWidth > 0) {
                        setMiniPos({ x: window.innerWidth > 768 ? window.innerWidth - 340 : (window.innerWidth - 220) / 2, y: 80 });
                    }
                    loadSavedClips();
                    loadHistory();
                }, []);

                const loadSavedClips = async () => {
                    try {
                        const res = await fetch('/api/get_my_clips');
                        if (res.ok) {
                            const data = await res.json();
                            if (data.clips) {
                                setCutClips(data.clips);
                                setSelectedMyClips(data.clips.map(c => c.id));
                            }
                        }
                    } catch (e) {}
                };

                const loadHistory = async () => {
                    try {
                        const res = await fetch('/api/get_history');
                        if (res.ok) {
                            const data = await res.json();
                            setHistory(data.history || []);
                        }
                    } catch(e){}
                };

                let healthFailCount = useRef(0);
                useEffect(() => {
                    const checkHealth = async () => {
                        try {
                            const res = await fetch('/api/health');
                            if (res.ok) {
                                healthFailCount.current = 0;
                                if (!isServerOnline) { setIsServerOnline(true); addToast("Server kembali terhubung!", "success"); }
                            } else throw new Error();
                        } catch (e) {
                            healthFailCount.current += 1;
                            if (healthFailCount.current > 2 && isServerOnline) { setIsServerOnline(false); addToast("Koneksi ke Server terputus!", "error"); }
                        }
                    };
                    const iv = setInterval(checkHealth, 1000);
                    return () => clearInterval(iv);
                }, [isServerOnline]);

                useEffect(() => {
                    let iv;
                    if (videoIdHash && downloadStatus === 'downloading') {
                        iv = setInterval(async () => {
                            try {
                                const res = await fetch(`/api/check_download/${videoIdHash}`);
                                const data = await res.json();
                                if (data.status === 'downloading') {
                                    setDownloadProgress(data.progress || 0);
                                } else if (data.status === 'done') {
                                    setDownloadStatus('done');
                                    setDownloadProgress(100);
                                    if (data.size_str) {
                                        setVideoMeta(prev => prev ? { ...prev, size_str: data.size_str } : prev);
                                    }
                                    if (videoRef.current && (videoRef.current.error || videoRef.current.readyState === 0)) {
                                        setVideoUrl(`/static/raw_videos/${videoIdHash}.mp4?t=${Date.now()}`);
                                    }
                                    addToast("Video full berhasil di-download! Siap dipotong.", "success");
                                    loadHistory();
                                } else if (data.status === 'blocked') {
                                    setDownloadStatus('blocked');
                                    addToast("Server diblokir YouTube! Solusi: Ganti IP atau Restart Colab.", "error");
                                } else if (data.status === 'error') {
                                    setDownloadStatus('error');
                                    addToast("Terjadi error saat mendownload video background.", "error");
                                }
                            } catch(e) {}
                        }, 1000);
                    }
                    return () => clearInterval(iv);
                }, [videoIdHash, downloadStatus]);

                const handleDragStart = (e) => {
                    if (!isMiniPlayer) return;
                    if (e.target.closest('button') || e.target.tagName.toLowerCase() === 'input') return;

                    const rect = e.currentTarget.getBoundingClientRect();
                    const x = e.clientX || (e.touches && e.touches[0].clientX);
                    const y = e.clientY || (e.touches && e.touches[0].clientY);
                    if (x > rect.right - 25 && y > rect.bottom - 25) return;

                    const startX = x;
                    const startY = y;
                    const initialX = miniPos.x;
                    const initialY = miniPos.y;

                    const onMove = (moveEvent) => {
                        const clientX = moveEvent.clientX || (moveEvent.touches && moveEvent.touches[0].clientX);
                        const clientY = moveEvent.clientY || (moveEvent.touches && moveEvent.touches[0].clientY);
                        setMiniPos({
                            x: initialX + (clientX - startX),
                            y: initialY + (clientY - startY)
                        });
                    };

                    const onUp = () => {
                        document.removeEventListener('mousemove', onMove);
                        document.removeEventListener('mouseup', onUp);
                        document.removeEventListener('touchmove', onMove);
                        document.removeEventListener('touchend', onUp);
                    };

                    document.addEventListener('mousemove', onMove);
                    document.addEventListener('mouseup', onUp);
                    document.addEventListener('touchmove', onMove, { passive: false });
                    document.addEventListener('touchmove', onUp);
                };

                const handleSeekAndExtend = (clipId, currentVidTime, amount, isFullScreen = false) => {
                    const targetClip = clips.find(c => c.id === clipId);
                    if (!targetClip) return;

                    let newTime = currentVidTime + amount;
                    let updatedStart = targetClip.start;
                    let updatedEnd = targetClip.end;
                    let didUpdate = false;

                    if (newTime < targetClip.start) {
                    updatedStart = Math.max(0, targetClip.start - 1);
                    newTime = updatedStart;
                    didUpdate = true;
                    } else if (newTime > targetClip.end) {
                    updatedEnd = Math.min(duration || targetClip.end + 1, targetClip.end + 1);
                    newTime = updatedEnd;
                    didUpdate = true;
                    }

                    if (didUpdate) {
                    setClips(prev => prev.map(c => c.id === clipId ? { ...c, start: updatedStart, end: updatedEnd } : c));
                    }

                    if (!isFullScreen && videoRef.current) {
                    if (previewingClipId !== clipId) setPreviewingClipId(clipId);
                    videoRef.current.currentTime = newTime;
                    setCurrentTime(newTime);
                    }
                };

                const generateSholatReminder = async () => {
                    setIsGeneratingReminder(true);
                    const fallbacks = [
                        "Sebanyak apapun cuan lu hari ini, gak bakal berkah kalo kewajiban ke Sang Pencipta lu skip. Gas sholat 5 waktu cuy!",
                        "Sukses jalur langit itu nyata bro. Jangan cuma ngejar views dan followers, kejar juga ridho-Nya lewat sholat.",
                        "Cuan bisa dicari, tapi waktu sholat nggak bisa diulang. Jangan lupa utamain kewajiban lu sebagai hamba-Nya ya!"
                    ];
                    setSholatReminder(fallbacks[Math.floor(Math.random() * fallbacks.length)]);
                    setIsGeneratingReminder(false);
                };

                const readAloud = () => {
                    if (!sholatReminder || isGeneratingReminder) return;
                    if (isReading) {
                    window.speechSynthesis.cancel();
                    setIsReading(false);
                    return;
                    }
                    const utterance = new SpeechSynthesisUtterance(sholatReminder);
                    utterance.lang = 'id-ID';
                    utterance.onstart = () => setIsReading(true);
                    utterance.onend = () => setIsReading(false);
                    utterance.onerror = () => setIsReading(false);
                    window.speechSynthesis.cancel();
                    window.speechSynthesis.speak(utterance);
                };

                useEffect(() => {
                    if (isGeneratingReminder && isReading) {
                    window.speechSynthesis.cancel();
                    setIsReading(false);
                    }
                }, [isGeneratingReminder]);

                useEffect(() => {
                    if (!sholatReminder) {
                    generateSholatReminder();
                    }
                }, []);

                useEffect(() => {
                    const handleMouseMove = (e) => {
                    if (!isDragging || !containerRef.current) return;
                    const containerRect = containerRef.current.getBoundingClientRect();
                    let newLeftWidth = ((e.clientX - containerRect.left) / containerRect.width) * 100;
                    if (newLeftWidth < 20) newLeftWidth = 20;
                    if (newLeftWidth > 80) newLeftWidth = 80;
                    setLeftWidth(newLeftWidth);
                    };

                    const handleMouseUp = () => {
                    setIsDragging(false);
                    document.body.style.userSelect = 'auto';
                    };

                    if (isDragging) {
                    window.addEventListener('mousemove', handleMouseMove);
                    window.addEventListener('mouseup', handleMouseUp);
                    document.body.style.userSelect = 'none';
                    }

                    return () => {
                    window.removeEventListener('mousemove', handleMouseMove);
                    window.removeEventListener('mouseup', handleMouseUp);
                    };
                }, [isDragging]);

                const handleTextareaChange = (e) => {
                    const val = e.target.value;
                    const lines = val.split('\n');
                    if (lines.length > 0 && (lines[0].includes('http://') || lines[0].includes('https://'))) {
                        setYoutubeUrlInput(lines[0].trim());
                        setCsvText(lines.slice(1).join('\n').trim());
                        addToast("Link terdeteksi dan dipindahkan ke Kotak Input!", "success");
                    } else {
                        setCsvText(val);
                    }
                };

                const handleYoutubeLoad = async () => {
                    if (!youtubeUrlInput) { addToast("Isi link YouTube lu cuy!", "warning"); return; }
                    setIsFetchingUrl(true);
                    try {
                        const res = await fetch('/api/load_video', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ url: youtubeUrlInput })
                        });
                        if (!res.ok) throw new Error("Gagal mendownload video full.");
                        const data = await res.json();

                        setDuration(0);
                        setCurrentTime(0);
                        setIsPlaying(false);
                        setVideoUrl(`${data.direct_url}?t=${Date.now()}`);
                        setVideoIdHash(data.video_id);
                        setVideoMeta({
                            title: data.title,
                            uploader: data.uploader,
                            resolution: data.resolution,
                            size_str: data.size_str,
                            duration_str: data.duration_str
                        });

                        setFile(youtubeUrlInput);
                        setCurrentView('editor');

                        if (data.status === 'downloading') {
                            setDownloadStatus('downloading');
                            setDownloadProgress(0);
                            addToast("Video & Transcript sedang didownload!", "info");
